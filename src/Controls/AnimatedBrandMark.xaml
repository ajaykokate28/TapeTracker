<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="TapeTracker.Controls.AnimatedBrandMark"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">

    <!--
        The brand mark uses AnchorX/Y = 0.5 so the pulse scales from the
        centre, and Aspect="AspectFit" so the SVG stays crisp regardless of
        the container's WidthRequest.
    -->
    <Image
        x:Name="Icon"
        Source="tapemark.svg"
        Aspect="AspectFit"
        AnchorX="0.5"
        AnchorY="0.5" />
</ContentView>
