<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TapeTracker.ViewModels"
             x:Class="TapeTracker.Views.BackupManagerPage"
             x:DataType="vm:BackupManagerViewModel"
             Title="{Binding L.BackupManagerTitle}"
             BackgroundColor="{AppThemeBinding Light={StaticResource AppBackground}, Dark={StaticResource AppBackgroundDark}}">

    <ScrollView>
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="0">

            <!-- ═══════════════ HEADER ═══════════════ -->
            <Border Grid.Row="0" StrokeThickness="0" Padding="20,22,20,32">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0EA5E9" Offset="0.0" />
                        <GradientStop Color="#2563EB" Offset="0.55" />
                        <GradientStop Color="#7C3AED" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Border Grid.Column="0"
                            WidthRequest="46" HeightRequest="46"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="#33FFFFFF"
                            Stroke="#55FFFFFF" StrokeThickness="1"
                            VerticalOptions="Center">
                        <Label Text="&#x1F5C4;" FontSize="22"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="{Binding L.BackupManagerTitle}"
                               FontFamily="OpenSansSemibold" FontSize="20"
                               TextColor="White" />
                        <Label Text="{Binding L.BackupManagerSubtitle}"
                               FontSize="12"
                               TextColor="#C7D2FE" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- ═══════════════ ACTIONS CARD (Backup Now / Restore from file) ═══════════════ -->
            <Border Grid.Row="1"
                    Margin="16,-16,16,10" Padding="16"
                    StrokeShape="RoundRectangle 16"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource CardStroke}, Dark={StaticResource CardStrokeDark}}"
                    StrokeThickness="1">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding L.OptionalPassphraseLabel}"
                           FontSize="12" FontFamily="OpenSansSemibold"
                           CharacterSpacing="1.2"
                           TextColor="{StaticResource SubtleText}" />
                    <Entry Text="{Binding BackupPassphrase}"
                           Placeholder="{Binding L.PassphrasePh}"
                           IsPassword="True"
                           HeightRequest="46" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Grid.Column="0"
                                Text="{Binding L.BackupNowLabel}"
                                Command="{Binding BackupNowCommand}"
                                FontAttributes="Bold"
                                HeightRequest="46" CornerRadius="12" />
                        <Button Grid.Column="1"
                                Text="{Binding L.RestoreFromFileLabel}"
                                Command="{Binding RestoreFromFileCommand}"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource Primary}"
                                BorderColor="{StaticResource Primary}"
                                BorderWidth="1"
                                HeightRequest="46" CornerRadius="12" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- ═══════════════ AUTO-BACKUP SETTINGS ═══════════════ -->
            <Border Grid.Row="2"
                    Margin="16,6,16,10" Padding="16"
                    StrokeShape="RoundRectangle 16"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource CardStroke}, Dark={StaticResource CardStrokeDark}}"
                    StrokeThickness="1">
                <VerticalStackLayout Spacing="14">
                    <Label Text="{Binding L.AutoBackupSectionLabel}"
                           FontSize="12" FontFamily="OpenSansSemibold"
                           CharacterSpacing="1.4"
                           TextColor="{StaticResource SubtleText}" />

                    <!-- Enabled toggle -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="{Binding L.AutoBackupEnabledLabel}"
                                   FontFamily="OpenSansSemibold" FontSize="15"
                                   TextColor="{AppThemeBinding Light={StaticResource PrimaryText}, Dark={StaticResource PrimaryTextDark}}" />
                            <Label Text="{Binding L.AutoBackupEnabledHint}"
                                   FontSize="12" TextColor="{StaticResource SubtleText}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1"
                                IsToggled="{Binding AutoBackupEnabled}"
                                VerticalOptions="Center" />
                    </Grid>

                    <BoxView HeightRequest="1"
                             BackgroundColor="{StaticResource DividerLine}" />

                    <!-- Interval + retention -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <Label Text="{Binding L.IntervalDaysLabel}"
                                   FontSize="12" TextColor="{StaticResource SubtleText}" />
                            <Stepper Minimum="1" Maximum="30" Increment="1"
                                     Value="{Binding IntervalDays}" />
                            <Label Text="{Binding IntervalDays}"
                                   FontSize="14" FontFamily="OpenSansSemibold"
                                   TextColor="{AppThemeBinding Light={StaticResource PrimaryText}, Dark={StaticResource PrimaryTextDark}}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="{Binding L.RetentionLabel}"
                                   FontSize="12" TextColor="{StaticResource SubtleText}" />
                            <Stepper Minimum="1" Maximum="50" Increment="1"
                                     Value="{Binding RetentionCount}" />
                            <Label Text="{Binding RetentionCount}"
                                   FontSize="14" FontFamily="OpenSansSemibold"
                                   TextColor="{AppThemeBinding Light={StaticResource PrimaryText}, Dark={StaticResource PrimaryTextDark}}" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Last run -->
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="{Binding L.LastAutoBackupLabel}"
                               FontSize="12" TextColor="{StaticResource SubtleText}" VerticalOptions="Center" />
                        <Label Text=":" FontSize="12" TextColor="{StaticResource SubtleText}" VerticalOptions="Center" />
                        <Label Text="{Binding LastAutoLabel}"
                               FontSize="12" FontFamily="OpenSansSemibold"
                               TextColor="{AppThemeBinding Light={StaticResource PrimaryText}, Dark={StaticResource PrimaryTextDark}}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <BoxView HeightRequest="1"
                             BackgroundColor="{StaticResource DividerLine}" />

                    <!-- Passphrase controls -->
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Grid.Column="0"
                                   Text="{Binding L.AutoBackupPassphraseLabel}"
                                   FontFamily="OpenSansSemibold" FontSize="15"
                                   TextColor="{AppThemeBinding Light={StaticResource PrimaryText}, Dark={StaticResource PrimaryTextDark}}" />
                            <!-- "Saved" chip when a passphrase is stored -->
                            <Border Grid.Column="1"
                                    IsVisible="{Binding HasStoredPassphrase}"
                                    StrokeShape="RoundRectangle 8"
                                    BackgroundColor="#DCFCE7"
                                    StrokeThickness="0" Padding="8,3"
                                    VerticalOptions="Center">
                                <Label Text="{Binding L.SavedLabel}"
                                       FontSize="11" FontFamily="OpenSansSemibold"
                                       TextColor="#166534" />
                            </Border>
                        </Grid>

                        <Label Text="{Binding L.AutoBackupPassphraseHint}"
                               FontSize="12" TextColor="{StaticResource SubtleText}" />

                        <Entry Text="{Binding AutoPassphraseInput}"
                               Placeholder="{Binding L.PassphrasePh}"
                               IsPassword="True"
                               HeightRequest="46" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Button Grid.Column="0"
                                    Text="{Binding L.SaveButtonLabel}"
                                    Command="{Binding SaveAutoPassphraseCommand}"
                                    HeightRequest="42" CornerRadius="10" />
                            <Button Grid.Column="1"
                                    Text="{Binding L.ClearPassphraseLabel}"
                                    Command="{Binding ClearAutoPassphraseCommand}"
                                    IsVisible="{Binding HasStoredPassphrase}"
                                    BackgroundColor="Transparent"
                                    TextColor="#DC2626"
                                    BorderColor="#DC2626"
                                    BorderWidth="1"
                                    HeightRequest="42" CornerRadius="10" />
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- ═══════════════ SECTION HEADER for local list ═══════════════ -->
            <Label Grid.Row="3"
                   Text="{Binding L.LocalBackupsLabel}"
                   Margin="20,10,20,6"
                   FontFamily="OpenSansSemibold" FontSize="12"
                   CharacterSpacing="1.4"
                   TextColor="{StaticResource SubtleText}" />

            <!-- ═══════════════ LOCAL BACKUP LIST ═══════════════ -->
            <CollectionView Grid.Row="4"
                            ItemsSource="{Binding Backups}"
                            Margin="16,0,16,20"
                            SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center"
                                         Spacing="10" Padding="24,24"
                                         IsVisible="{Binding IsEmpty}">
                        <Label Text="&#x1F4C1;" FontSize="34"
                               HorizontalOptions="Center" />
                        <Label Text="{Binding L.NoBackupsTitle}"
                               FontFamily="OpenSansSemibold" FontSize="16"
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource PrimaryText}, Dark={StaticResource PrimaryTextDark}}" />
                        <Label Text="{Binding L.NoBackupsHint}"
                               FontSize="12" TextColor="{StaticResource SubtleText}"
                               HorizontalTextAlignment="Center"
                               MaximumWidthRequest="300" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:BackupRowViewModel">
                        <Border Margin="0,6" Padding="14"
                                StrokeShape="RoundRectangle 14"
                                BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                                Stroke="{AppThemeBinding Light={StaticResource CardStroke}, Dark={StaticResource CardStrokeDark}}"
                                StrokeThickness="1">
                            <VerticalStackLayout Spacing="10">

                                <!-- Row 1: file name + badges -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Grid.Column="0"
                                           Text="{Binding FileName}"
                                           FontFamily="OpenSansSemibold" FontSize="14"
                                           TextColor="{AppThemeBinding Light={StaticResource PrimaryText}, Dark={StaticResource PrimaryTextDark}}"
                                           LineBreakMode="MiddleTruncation" />
                                    <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                        <!-- Auto badge -->
                                        <Border IsVisible="{Binding IsAuto}"
                                                StrokeShape="RoundRectangle 6"
                                                BackgroundColor="#EDE9FE"
                                                StrokeThickness="0" Padding="7,2">
                                            <Label Text="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.L.AutoBadge}"
                                                   FontSize="10" FontFamily="OpenSansSemibold"
                                                   TextColor="#6D28D9" />
                                        </Border>
                                        <!-- Encrypted / plain badge -->
                                        <Border StrokeShape="RoundRectangle 6"
                                                BackgroundColor="{Binding IsEncrypted, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#DCFCE7|#F1F5F9'}"
                                                StrokeThickness="0" Padding="7,2">
                                            <Label Text="{Binding BadgeLabel}"
                                                   FontSize="10" FontFamily="OpenSansSemibold"
                                                   TextColor="{Binding IsEncrypted, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#166534|#475569'}" />
                                        </Border>
                                    </HorizontalStackLayout>
                                </Grid>

                                <!-- Row 2: date + size -->
                                <HorizontalStackLayout Spacing="12">
                                    <Label Text="{Binding CreatedLabel}"
                                           FontSize="12" TextColor="{StaticResource SubtleText}" />
                                    <Label Text="·" FontSize="12" TextColor="{StaticResource SubtleText}" />
                                    <Label Text="{Binding SizeLabel}"
                                           FontSize="12" TextColor="{StaticResource SubtleText}" />
                                </HorizontalStackLayout>

                                <!-- Row 3: actions -->
                                <FlexLayout Direction="Row" Wrap="Wrap"
                                            AlignItems="Center" JustifyContent="Start">
                                    <Border StrokeShape="RoundRectangle 10"
                                            BackgroundColor="{StaticResource PrimarySoft}"
                                            StrokeThickness="0"
                                            Padding="12,7" Margin="0,0,8,6">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RestoreThisCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.L.RestoreThisLabel}"
                                               FontSize="12" FontFamily="OpenSansSemibold"
                                               TextColor="{StaticResource Primary}" />
                                    </Border>

                                    <Border StrokeShape="RoundRectangle 10"
                                            BackgroundColor="Transparent"
                                            Stroke="{StaticResource CardStroke}" StrokeThickness="1"
                                            Padding="12,7" Margin="0,0,8,6">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ShareCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <HorizontalStackLayout Spacing="5">
                                            <Label Text="&#x1F4E4;" FontSize="12" VerticalOptions="Center" />
                                            <Label Text="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.L.ShareLabel}"
                                                   FontSize="12" FontFamily="OpenSansSemibold"
                                                   TextColor="{AppThemeBinding Light={StaticResource PrimaryText}, Dark={StaticResource PrimaryTextDark}}"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Border>

                                    <Border StrokeShape="RoundRectangle 10"
                                            BackgroundColor="Transparent"
                                            Stroke="#DC2626" StrokeThickness="1"
                                            Padding="12,7" Margin="0,0,8,6">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <HorizontalStackLayout Spacing="5">
                                            <Label Text="&#x1F5D1;" FontSize="12" VerticalOptions="Center" />
                                            <Label Text="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.L.DeleteLabel}"
                                                   FontSize="12" FontFamily="OpenSansSemibold"
                                                   TextColor="#DC2626"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Border>
                                </FlexLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </ScrollView>
</ContentPage>
