<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TapeTracker.ViewModels"
             x:Class="TapeTracker.Views.EmployeeListPage"
             x:DataType="vm:EmployeeListViewModel"
             Title="{Binding L.EmployeesLabel}"
             BackgroundColor="{AppThemeBinding Light={StaticResource AppBackground}, Dark={StaticResource AppBackgroundDark}}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{Binding L.AddEmployeeLabel}"
                     Command="{Binding AddCommand}"
                     Order="Primary" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*">

        <!-- ═══════════════ HEADER ═══════════════ -->
        <Border Grid.Row="0" StrokeThickness="0" Padding="20,22,20,32">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#4F46E5" Offset="0.0" />
                    <GradientStop Color="#6D28D9" Offset="0.55" />
                    <GradientStop Color="#DB2777" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                <Border Grid.Column="0"
                        WidthRequest="46" HeightRequest="46"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="#33FFFFFF"
                        Stroke="#55FFFFFF" StrokeThickness="1"
                        VerticalOptions="Center">
                    <Label Text="&#x1F465;" FontSize="22"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label Text="{Binding L.TeamLabel}"
                           FontFamily="OpenSansSemibold" FontSize="11"
                           CharacterSpacing="1.4" TextColor="#C7D2FE" />
                    <Label FontFamily="OpenSansSemibold" FontSize="22"
                           TextColor="White">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding Employees.Count}" />
                                <Span Text=" " />
                                <Span Text="{Binding L.EmployeesLabel}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>

                <!-- Add CTA -->
                <Border Grid.Column="2"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="White"
                        StrokeThickness="0"
                        Padding="14,8" VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AddCommand}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="+" FontSize="16" FontFamily="OpenSansSemibold"
                               TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                        <Label Text="{Binding L.AddEmployeeLabel}" FontSize="13" FontFamily="OpenSansSemibold"
                               TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>
        </Border>

        <!-- ═══════════════ LIST ═══════════════ -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Employees}"
                        Margin="16,-16,16,16">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center"
                                     Spacing="14" Padding="32,60"
                                     IsVisible="{Binding IsEmpty}">
                    <Border WidthRequest="86" HeightRequest="86"
                            StrokeShape="RoundRectangle 43"
                            Background="{StaticResource AvatarGradient}"
                            StrokeThickness="0"
                            HorizontalOptions="Center">
                        <Label Text="&#x1F465;" FontSize="34"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="{Binding L.NoEmployeesTitle}"
                           FontFamily="OpenSansSemibold" FontSize="18"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource PrimaryText}, Dark={StaticResource PrimaryTextDark}}" />
                    <Label Text="{Binding L.NoEmployeesHint}"
                           FontSize="13" TextColor="{StaticResource SubtleText}"
                           HorizontalTextAlignment="Center"
                           MaximumWidthRequest="320" />
                    <Button Text="{Binding L.AddEmployeeLabel}"
                            Command="{Binding AddCommand}"
                            HeightRequest="46" WidthRequest="220" CornerRadius="12"
                            FontAttributes="Bold" FontSize="14" Margin="0,10,0,0" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:EmployeeRowViewModel">
                    <!-- No Border.Shadow in item templates (crashes Microsoft.UI.Xaml on Windows). -->
                    <Border Margin="0,6" Padding="0"
                            StrokeShape="RoundRectangle 16"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource CardStroke}, Dark={StaticResource CardStrokeDark}}"
                            StrokeThickness="1">
                        <VerticalStackLayout Spacing="0">

                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14"
                                  Padding="16,14">
                                <!-- Avatar -->
                                <Border Grid.Column="0"
                                        WidthRequest="48" HeightRequest="48"
                                        StrokeShape="RoundRectangle 24"
                                        Background="{StaticResource AvatarGradient}"
                                        StrokeThickness="0"
                                        VerticalOptions="Center">
                                    <Label FontFamily="OpenSansSemibold" FontSize="17"
                                           TextColor="{StaticResource Primary}"
                                           HorizontalOptions="Center" VerticalOptions="Center"
                                           Text="{Binding DisplayName, Converter={StaticResource InitialsConverter}}" />
                                </Border>

                                <!-- Info -->
                                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="{Binding DisplayName}"
                                               FontFamily="OpenSansSemibold" FontSize="16"
                                               TextColor="{AppThemeBinding Light={StaticResource PrimaryText}, Dark={StaticResource PrimaryTextDark}}"
                                               VerticalOptions="Center" />
                                        <Label Text="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.L.YouLabel}"
                                               FontSize="11" TextColor="{StaticResource Primary}"
                                               VerticalOptions="Center"
                                               IsVisible="{Binding IsSelf}" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="&#x1F464;" FontSize="11" VerticalOptions="Center" Opacity="0.7" />
                                        <Label Text="{Binding Username}" FontSize="13"
                                               TextColor="{StaticResource SubtleText}" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Spacing="6">
                                        <!-- Role chip -->
                                        <Border StrokeShape="RoundRectangle 8"
                                                BackgroundColor="{StaticResource PrimarySoft}"
                                                StrokeThickness="0" Padding="8,3">
                                            <Label Text="{Binding RoleLabel}" FontSize="11"
                                                   FontFamily="OpenSansSemibold"
                                                   TextColor="{StaticResource Primary}" />
                                        </Border>
                                        <!-- Active/Inactive badge -->
                                        <Border StrokeShape="RoundRectangle 8"
                                                BackgroundColor="{Binding IsActive, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#DCFCE7|#FEE2E2'}"
                                                StrokeThickness="0" Padding="8,3">
                                            <Label Text="{Binding ActiveLabel}" FontSize="11"
                                                   FontFamily="OpenSansSemibold"
                                                   TextColor="{Binding IsActive, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#166534|#B91C1C'}" />
                                        </Border>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <!-- Edit chevron -->
                                <Border Grid.Column="2"
                                        StrokeShape="RoundRectangle 12"
                                        BackgroundColor="Transparent"
                                        Stroke="{StaticResource CardStroke}" StrokeThickness="1"
                                        Padding="10,6" VerticalOptions="Center">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="5">
                                        <Label Text="&#x270E;" FontSize="12" VerticalOptions="Center" />
                                        <Label Text="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.L.EditLabel}"
                                               FontSize="12" FontFamily="OpenSansSemibold"
                                               TextColor="{AppThemeBinding Light={StaticResource PrimaryText}, Dark={StaticResource PrimaryTextDark}}"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>

                            <BoxView HeightRequest="1"
                                     BackgroundColor="{StaticResource DividerLine}"
                                     Margin="16,0" />

                            <!-- Action row -->
                            <FlexLayout Padding="14,10,14,14"
                                        Direction="Row" Wrap="Wrap"
                                        AlignItems="Center" JustifyContent="Start">
                                <FlexLayout.Resources>
                                    <Thickness x:Key="ActionMargin">0,0,8,8</Thickness>
                                </FlexLayout.Resources>

                                <!-- Reset password -->
                                <Border StrokeShape="RoundRectangle 10"
                                        BackgroundColor="Transparent"
                                        Stroke="{StaticResource CardStroke}" StrokeThickness="1"
                                        Padding="12,7"
                                        Margin="{StaticResource ActionMargin}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ResetPasswordCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="5">
                                        <Label Text="&#x1F511;" FontSize="12" VerticalOptions="Center" />
                                        <Label Text="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.L.ResetPasswordShortLabel}"
                                               FontSize="12" FontFamily="OpenSansSemibold"
                                               TextColor="{AppThemeBinding Light={StaticResource PrimaryText}, Dark={StaticResource PrimaryTextDark}}"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>

                                <!-- Deactivate / Activate (hidden for self) -->
                                <Border StrokeShape="RoundRectangle 10"
                                        BackgroundColor="Transparent"
                                        Stroke="{Binding IsActive, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#DC2626|#059669'}"
                                        StrokeThickness="1"
                                        Padding="12,7"
                                        Margin="{StaticResource ActionMargin}"
                                        IsVisible="{Binding CanToggleActivation}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ToggleActivationCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label FontSize="12" FontFamily="OpenSansSemibold" VerticalOptions="Center"
                                           TextColor="{Binding IsActive, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#DC2626|#059669'}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Text"
                                                        Value="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.L.DeactivateLabel}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsActive}" Value="False">
                                                <Setter Property="Text"
                                                        Value="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.L.ActivateLabel}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                            </FlexLayout>

                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ActivityIndicator Grid.Row="1"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center" VerticalOptions="Center"
                           Color="{StaticResource Primary}" />
    </Grid>
</ContentPage>
