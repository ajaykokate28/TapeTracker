<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TapeTracker.ViewModels"
             x:Class="TapeTracker.Views.ForgotPasswordPage"
             x:DataType="vm:ForgotPasswordViewModel"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource AppBackground}, Dark={StaticResource AppBackgroundDark}}">

    <ContentPage.Resources>
        <Style x:Key="FieldWrap" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 10" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource EntrySurface}, Dark={StaticResource EntrySurfaceDark}}" />
            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource CardStroke}, Dark={StaticResource CardStrokeDark}}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Padding" Value="10,0" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="Label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="CharacterSpacing" Value="0.6" />
            <Setter Property="TextColor" Value="{StaticResource Gray500}" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="0" Padding="0,0,0,40">

            <!-- ═══════════════ HEADER ═══════════════ -->
            <Border StrokeThickness="0" Padding="24,44,24,60">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#4F46E5" Offset="0.0" />
                        <GradientStop Color="#6D28D9" Offset="0.55" />
                        <GradientStop Color="#DB2777" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Label Text="&#x1F510;" FontSize="46"
                           HorizontalOptions="Center" TextColor="White" />
                    <Label Text="{Binding L.ForgotPasswordTitle}"
                           FontFamily="OpenSansSemibold" FontSize="22"
                           TextColor="White" HorizontalOptions="Center" />
                    <Label Text="{Binding L.ForgotPasswordSubtitle}"
                           FontSize="12" TextColor="#E0E7FF"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap"
                           MaximumWidthRequest="320" />
                </VerticalStackLayout>
            </Border>

            <!-- ═══════════════ CARD ═══════════════ -->
            <Border Margin="18,-32,18,0"
                    StrokeShape="RoundRectangle 16"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                    Stroke="{StaticResource CardStroke}" StrokeThickness="1"
                    Padding="20,22">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,8" Radius="24" Opacity="0.08" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="16">

                    <!--
                        Banner sits at the top of the card so it's the first
                        thing users see after every step. BannerIsError drives
                        the tint: red for "wrong answer", blue for "no recovery
                        question configured — ask your admin".
                    -->
                    <Border IsVisible="{Binding HasBanner}"
                            StrokeShape="RoundRectangle 10"
                            BackgroundColor="{Binding BannerIsError, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#FEE2E2|#DBEAFE'}"
                            Stroke="{Binding BannerIsError, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#DC2626|#2563EB'}"
                            StrokeThickness="1"
                            Padding="12,10">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Label Grid.Column="0"
                                   Text="&#x2139;" FontSize="14"
                                   TextColor="{Binding BannerIsError, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#DC2626|#2563EB'}"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="{Binding BannerMessage}"
                                   FontSize="12"
                                   TextColor="{Binding BannerIsError, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#DC2626|#1E40AF'}"
                                   LineBreakMode="WordWrap" VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- ══════ STEP 1: Enter username ══════ -->
                    <VerticalStackLayout Spacing="14" IsVisible="{Binding IsStepUsername}">
                        <Label Text="{Binding L.ForgotStep1Hint}"
                               FontSize="12" TextColor="{StaticResource SubtleText}"
                               LineBreakMode="WordWrap" />
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding L.UsernameLabel}" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource FieldWrap}">
                                <Entry Text="{Binding Username}"
                                       Placeholder="{Binding L.UsernamePh}"
                                       ReturnType="Next"
                                       ReturnCommand="{Binding ContinueCommand}" />
                            </Border>
                        </VerticalStackLayout>
                        <Button Text="{Binding L.ContinueLabel}"
                                Command="{Binding ContinueCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                HeightRequest="48" CornerRadius="12"
                                FontFamily="OpenSansSemibold" FontSize="14" />
                    </VerticalStackLayout>

                    <!-- ══════ STEP 2: Answer + new password ══════ -->
                    <VerticalStackLayout Spacing="14" IsVisible="{Binding IsStepAnswer}">

                        <Border StrokeShape="RoundRectangle 10"
                                BackgroundColor="{StaticResource PrimarySoft}"
                                StrokeThickness="0"
                                Padding="12,10">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding L.ForgotYourQuestionLabel}"
                                       FontSize="10" FontFamily="OpenSansSemibold"
                                       TextColor="{StaticResource Primary}"
                                       CharacterSpacing="0.6" />
                                <Label Text="{Binding RecoveryQuestion}"
                                       FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource PrimaryText}, Dark={StaticResource PrimaryTextDark}}"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding L.ForgotAnswerLabel}" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource FieldWrap}">
                                <Entry Text="{Binding Answer}"
                                       Placeholder="{Binding L.ForgotAnswerPh}"
                                       ReturnType="Next" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding L.NewPasswordLabel}" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource FieldWrap}">
                                <Entry Text="{Binding NewPassword}"
                                       IsPassword="True"
                                       Placeholder="{Binding L.NewPasswordPh}"
                                       ReturnType="Next" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding L.ConfirmPasswordLabel}" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource FieldWrap}">
                                <Entry Text="{Binding ConfirmPassword}"
                                       IsPassword="True"
                                       Placeholder="{Binding L.ConfirmPasswordPh}"
                                       ReturnType="Go"
                                       ReturnCommand="{Binding ResetPasswordCommand}" />
                            </Border>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Grid.Column="0"
                                    Text="{Binding L.BackLabel}"
                                    Command="{Binding BackToUsernameCommand}"
                                    IsEnabled="{Binding IsNotBusy}"
                                    HeightRequest="48" CornerRadius="12"
                                    BackgroundColor="Transparent"
                                    BorderColor="{StaticResource CardStroke}"
                                    BorderWidth="1"
                                    TextColor="{StaticResource SubtleText}"
                                    FontFamily="OpenSansSemibold" FontSize="13" />
                            <Button Grid.Column="1"
                                    Text="{Binding L.ResetPasswordLabel}"
                                    Command="{Binding ResetPasswordCommand}"
                                    IsEnabled="{Binding IsNotBusy}"
                                    HeightRequest="48" CornerRadius="12"
                                    FontFamily="OpenSansSemibold" FontSize="13" />
                        </Grid>
                    </VerticalStackLayout>

                    <!-- ══════ STEP 3: Success ══════ -->
                    <VerticalStackLayout Spacing="12" IsVisible="{Binding IsStepDone}"
                                         HorizontalOptions="Center" Padding="0,20">
                        <Label Text="&#x2705;" FontSize="52" HorizontalOptions="Center" />
                        <Label Text="{Binding L.ForgotDoneTitle}"
                               FontFamily="OpenSansSemibold" FontSize="16"
                               TextColor="{AppThemeBinding Light={StaticResource PrimaryText}, Dark={StaticResource PrimaryTextDark}}"
                               HorizontalOptions="Center" />
                        <Label Text="{Binding L.ForgotDoneSubtitle}"
                               FontSize="12" TextColor="{StaticResource SubtleText}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap"
                               MaximumWidthRequest="280" />
                    </VerticalStackLayout>

                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       Color="{StaticResource Primary}"
                                       HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Back-to-login link. Rendered as a tap-through label so it
                 looks unlike an action button but still gets a target. -->
            <Border Margin="0,20,0,0"
                    HorizontalOptions="Center"
                    StrokeShape="RoundRectangle 18"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                    Stroke="{StaticResource CardStroke}" StrokeThickness="1"
                    Padding="14,7">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackToLoginTapped" />
                </Border.GestureRecognizers>
                <Label Text="{Binding L.BackToLoginLabel}"
                       FontSize="12" FontFamily="OpenSansSemibold"
                       TextColor="{StaticResource Primary}" />
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
