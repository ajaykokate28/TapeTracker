<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:TapeTracker"
             xmlns:conv="clr-namespace:TapeTracker.Converters"
             x:Class="TapeTracker.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Global converters available on every page -->
            <conv:InitialsConverter x:Key="InitialsConverter" />
            <conv:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <conv:NullToBoolConverter x:Key="NullToBoolConverter" />
            <conv:DeliveryDateColorConverter x:Key="DeliveryDateColorConverter" />
            <conv:BoolToColorConverter x:Key="BoolToColorConverter" />
            <conv:OrderStatusColorConverter x:Key="OrderStatusColorConverter" />
            <conv:OrderStatusToLocalizedStringConverter x:Key="OrderStatusToLocalizedStringConverter" />
            <conv:GreaterThanZeroConverter x:Key="GreaterThanZeroConverter" />
            <conv:PaymentMethodDisplayConverter x:Key="PaymentMethodDisplayConverter" />
            <conv:EqualsIntToColorConverter x:Key="EqualsIntToColorConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
